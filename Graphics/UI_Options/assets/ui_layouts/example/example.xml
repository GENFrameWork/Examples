<?xml version="1.0" encoding="UTF-8"?>
<layouts>
  <skin name="" drawmode="canvas" rasterfont="verdana18" vectorfont="Nunito-SemiBold.ttf" backgroundimg="seamless_pattern2.jpg" backgroundseamlesspattern="yes" > </skin>
  <stylesheet>example.css</stylesheet>
  
  <color name="colortext">yellow</color>   
  <color name="colormenuline">red</color>   
  <color name="colormenu">black,50</color>

  <text name="button_text">#[TEST_TEXT]</text>
 
  <animation name="gigolord_walk0">gigolord_walk0/LF-WxWalk_01#[02].png</animation>

  <layout name="example"> 
    
    <element name="text01" type="text" xpos="Center" ypos="840" sizefont="22" color="black" >Change tests in sentence: #[TEST_TEXT2]</element>    s

    <element name="textbox01" type="textbox"  xpos="650" ypos="475" width="400" height="350" textalignment="center" wordclipping="yes" linespacing="5" sizefont="18" color="red,50">
      <animation name="gigolord_walk1">gigolord_walk0/LF-WxWalk_02#[02].png</animation>
      <text>#[TRANSLATE_100]</text>
      <text>Una olla de algo más vaca que carnero, salpicón las más noches, duelos y quebrantos los sábados,</text>
      <text>lantejas los viernes, algún palomino de añadidura los domingos, consumían las tres partes de su hacienda.</text>  
      <text>El resto della concluían sayo de velarte, calzas de velludo para las fiestas , con sus pantuflos de lo mesmo, y los días de  entresemana se honraba con su vellorí de lo más fino.</text>      
    </element>    
    
  
    <element name="ListBoxMenuID" type="menu"  xpos="50" ypos="250" width="175" height="225" roundrect="15" linecolor="colormenuline" color="colormenu">
    </element>
    
    
        
    <element type="progressbar" name="progressbar0" xpos="50" ypos="300" width="175" height="22" allocationtext="right" direction="horizontal" roundcap="yes"  linecolor="60,60,60" bckgrdcolor="32,40,48" color="210,185,245" gradientcolor="140,80,225" gradientmode="track" progressrect="0,0,0,0" level="15">
     <element type="text" name="text0"  xpos="center" ypos="5" sizefont="18" color="black,100" >#[PROGRESSBAR_PERCENT]</element>
    </element>
  
    <element type="progressradial" name="progressbar1" xpos="50" ypos="475" width="150" height="150" level="15" thickness="18" roundcap="yes" startangle="-90" sweepangle="360" bckgrdcolor="32,40,48" color="160,195,255" gradientcolor="20,80,240" gradientmode="track">
      <element type="text" name="text1" xpos="center" ypos="center" sizefont="35" color="255,255,255">#[PROGRESSBAR_PERCENT]</element>
    </element> 
    
    
    <element  type="progressbar" name="progressbar2" xpos="220" ypos="375"  allocationtext="down" direction="horizontal"  progressrect="0,0,200,15" continuouscycle="33,10,10"  linecolor="black,60"  color="blue,30"  bckgrdcolor="white" level="15">       
    </element>
    
    <element type="progressbar" name="progressbar3" xpos="220" ypos="450"  allocationtext="down" direction="horizontal"  progressrect="0,0,175,30" linecolor="black,60"  color="160,195,255" gradientcolor="20,80,240" gradientmode="track"  bckgrdcolor="white"  level="15">
      <element type="text" name="text4"  xpos="center"  sizefont="18" color="black,100" >#[PROGRESSBAR_PERCENT]</element>
    </element>
    
    
    <element type="progressbar" name="progressbar4" xpos="350" ypos="300"  allocationtext="right" direction="vertical"  progressrect="0,0,30,175" linecolor="black,60"  color="160,195,255" gradientcolor="20,80,240" gradientmode="track"  bckgrdcolor="white"  level="15">
      <element type="text" name="text5" xpos="10" ypos="center"  sizefont="18" color="black,100" >#[PROGRESSBAR_PERCENT]</element>
    </element>
    
    <element type="progressimage" name="temp_bar" xpos="450" ypos="500"   allocationtext="right" direction="vertical" offsetstart="67" offsetend="33" level="15" imageempty="thermo_empty.png" imagefull="thermo_full.png">        
      <element type="text" name="text6" xpos="-10" ypos="center"  sizefont="38" color="black,100" >#[PROGRESSBAR_PERCENT]</element>
    </element>
   

    <element name="form" type="form"  class="card-outlined" xpos="700" ypos="100" width="275" height="75" roundrect="15" linecolor="colormenuline" color="colormenu">
      <element name="ID Edit" type="edittext" maxsizetext="10" xpos="20" ypos="20" sizefont="22" roundrect="15" bckgrdcolor="159,131,87,100" color="yellow" >0000000</element>
    </element>    
    
    <element name="menu_horz" type="form" class="card-shadow-lift" xpos="60" ypos="690"  visiblerect = "0,0,550,70" roundrect="15" linecolor="white,100" color="60,60,60, 70">

      <element name="chromeall-btn" type="multioption" xpos="80" ypos="20">

        <element name="chrome-btn" type="button" selectablestatus="active" allocationtext="down" sizefont="18">
          <element name="animation01" type="animation" xpos="center" ypos="-10" state="play" timedelay="35">
            <image>gigolord_walk0</image>
          </element>
          <element name="text01" type="text" xpos="center" sizefont="18" color="white,100" >button_text</element>
        </element>

        <element name="chrome-btn" type="button" selectablestatus="preselect"  allocationtext="down" sizefont="18">
          <element name="animation01" type="animation" xpos="center" ypos="-10" state="play" timedelay="35">
            <image>gigolord_walk0</image>
          </element>
          <element name="text01" type="text" xpos="center" sizefont="18" color="yellow,100" >button_text</element>
        </element>

        <element name="chrome-btn" type="button" selectablestatus="selected" allocationtext="down" sizefont="18">
          <element name="animation01" type="animation" xpos="center" ypos="10" state="play" timedelay="35">
            <image>gigolord_walk0</image>
          </element>
          <element name="text01" type="text" xpos="center" sizefont="18" color="yellow,100" >button_text</element>
        </element>

        <element name="chrome-btn" type="button" selectablestatus="deactive" allocationtext="down" sizefont="18">
          <element name="animation01" type="animation" xpos="center" ypos="-10" state="play" timedelay="35">
            <image>gigolord_walk0</image>
          </element>
          <element name="text01" type="text" xpos="center" sizefont="18" color="white,100" >button_text</element>
        </element>

      </element>

      <element name="email-btn" type="button" xpos="260" ypos="20" visiblelimit="active,preselect,select,deactive" allocationtext="down" sizefont="18" visible="yes">
        <element name="animation02" type="animation">
          <image>gmail-logo.png</image>
        </element>
        <element name="text01" type="text" xpos="center" sizefont="18" color="white,100" >Email</element>
      </element>

      <element name="youtube-btn" type="button" xpos="420" ypos="20" visiblelimit="active,preselect,select,deactive" allocationtext="down" sizefont="18">
        <element name="animation03" type="animation">
          <image>youtube-logo.png</image>
        </element>
        <element name="text01" type="text" xpos="center" sizefont="18" color="white,100" >Youtube</element>
      </element>

    </element>
    
    <element name="menu-btn" type="button" xpos="5" ypos="704" >
      <element name="animation00" type="animation">
        <image>menu_button.png</image>
      </element>
    </element>

    <element type="image" name="img_icon_minimize" xpos="760" ypos="790" width="350" height="350">tiger.svg</element>



  </layout>
  
 
</layouts> 


