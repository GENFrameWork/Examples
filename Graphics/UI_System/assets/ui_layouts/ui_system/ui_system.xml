<?xml version="1.0" encoding="UTF-8"?>
<layouts>
  <skin name="" drawmode="canvas" rasterfont="verdana18" vectorfont="Nunito-SemiBold.ttf" backgroundcolor="13,16,22,255" > </skin>

  <color name="colorpanel">30,36,48,255</color>
  <color name="colorpanelline">255,255,255,45</color>
  <color name="colorsidebar">15,18,24,255</color>
  <color name="colorsidebarbkg">15,15,15,255</color>
  <color name="colorbox">30,36,46,255</color>
  <color name="colortextmain">228,232,238,255</color>
  <color name="colortextsoft">146,156,171,255</color>
  <color name="colornavactive">33,58,105,190</color>
  <color name="coloraccent">90,190,230,255</color>
  <color name="colorgreen">120,220,190,255</color>

  <layout name="ui_system">

    <!-- ======================================================== BACKDROPS (drawn first) ======================================================== -->

    <element name="sidebar_bg" type="form" xpos="0" ypos="860" width="210" height="789" color="colorsidebar" linecolor="0,0,0,0"></element>
    <element name="footer_bg" type="form" xpos="0" ypos="900" width="1440" height="40" color="colorsidebar" linecolor="0,0,0,0"></element>
    <element name="header_divider" type="form" xpos="0" ypos="50" width="1440" height="1" color="colorpanelline" linecolor="0,0,0,0"></element>

    <element name="nav-resumen-hl" type="form" xpos="15" ypos="150" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="yes"></element>
    <element name="nav-cpu-hl" type="form" xpos="15" ypos="204" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>
    <element name="nav-memoria-hl" type="form" xpos="15" ypos="258" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>
    <element name="nav-red-hl" type="form" xpos="15" ypos="312" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>
    <element name="nav-disco-hl" type="form" xpos="15" ypos="366" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>
    <element name="nav-procesos-hl" type="form" xpos="15" ypos="420" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>
    <element name="nav-alertas-hl" type="form" xpos="15" ypos="474" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>
    <element name="nav-configuracion-hl" type="form" xpos="15" ypos="528" width="180" height="46" color="colornavactive" linecolor="0,0,0,0" roundrect="12" visible="no"></element>

    <element name="card_cpu_temp" type="form" xpos="240" ypos="430" width="360" height="340" color="colorpanel" linecolor="colorpanelline" roundrect="18"></element>
    <element name="card_cpu_usage" type="form" xpos="620" ypos="430" width="360" height="340" color="colorpanel" linecolor="colorpanelline" roundrect="18"></element>
    <element name="card_ram" type="form" xpos="1000" ypos="430" width="360" height="340" color="colorpanel" linecolor="colorpanelline" roundrect="18"></element>
    <element name="card_datetime" type="form" xpos="240" ypos="800" width="360" height="340" color="colorpanel" linecolor="colorpanelline" roundrect="18"></element>
    <element name="card_uptime" type="form" xpos="620" ypos="800" width="360" height="340" color="colorpanel" linecolor="colorpanelline" roundrect="18"></element>
    <element name="card_connection" type="form" xpos="1000" ypos="800" width="360" height="340" color="colorpanel" linecolor="colorpanelline" roundrect="18"></element>

    <element name="uptime_box_months" type="form" xpos="630" ypos="660" width="74" height="100" color="colorbox" linecolor="0,0,0,0" roundrect="10"></element>
    <element name="uptime_box_hours" type="form" xpos="716" ypos="660" width="74" height="100" color="colorbox" linecolor="0,0,0,0" roundrect="10"></element>
    <element name="uptime_box_years" type="form" xpos="802" ypos="660" width="74" height="100" color="colorbox" linecolor="0,0,0,0" roundrect="10"></element>
    <element name="uptime_box_seconds" type="form" xpos="888" ypos="660" width="74" height="100" color="colorbox" linecolor="0,0,0,0" roundrect="10"></element>

    <element name="connection_status_badge" type="form" xpos="1026" ypos="590" width="66" height="66" color="60,200,110,255" linecolor="0,0,0,0" roundrect="33"></element>

    <!-- ================================================================ SIDEBAR ================================================================ -->

    <element name="nav-resumen-btn" type="button" xpos="15" ypos="150" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-resumen-icon" type="animation" xpos="14" ypos="center"><image>icons/small_home.png</image></element>
      <element name="nav-resumen-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextmain">Resumen</element>
    </element>

    <element name="nav-cpu-btn" type="button" xpos="15" ypos="204" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-cpu-icon" type="animation" xpos="14" ypos="center"><image>icons/small_cpu.png</image></element>
      <element name="nav-cpu-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">CPU</element>
    </element>

    <element name="nav-memoria-btn" type="button" xpos="15" ypos="258" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-memoria-icon" type="animation" xpos="14" ypos="center"><image>icons/small_ram.png</image></element>
      <element name="nav-memoria-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">Memoria</element>
    </element>

    <element name="nav-red-btn" type="button" xpos="15" ypos="312" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-red-icon" type="animation" xpos="14" ypos="center"><image>icons/small_wifi.png</image></element>
      <element name="nav-red-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">Red</element>
    </element>

    <element name="nav-disco-btn" type="button" xpos="15" ypos="366" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-disco-icon" type="animation" xpos="14" ypos="center"><image>icons/small_disk.png</image></element>
      <element name="nav-disco-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">Disco</element>
    </element>

    <element name="nav-procesos-btn" type="button" xpos="15" ypos="420" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-procesos-icon" type="animation" xpos="14" ypos="center"><image>icons/small_processes.png</image></element>
      <element name="nav-procesos-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">Procesos</element>
    </element>

    <element name="nav-alertas-btn" type="button" xpos="15" ypos="474" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-alertas-icon" type="animation" xpos="14" ypos="center"><image>icons/small_bell.png</image></element>
      <element name="nav-alertas-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">Alertas</element>
    </element>

    <element name="nav-configuracion-btn" type="button" xpos="15" ypos="528" width="180" height="46" allocationtext="right" sizefont="16">
      <element name="nav-configuracion-icon" type="animation" xpos="14" ypos="center"><image>icons/small_gear.png</image></element>
      <element name="nav-configuracion-text" type="text"      xpos="46" ypos="center" sizefont="16" color="colortextsoft">Configuración</element>
    </element>

    <element name="sidebar_footer_brand" type="button" xpos="24" ypos="826" allocationtext="right" sizefont="15">
      <element name="sidebar_footer_brand_icon" type="animation"><image>icons/monitor_20.png</image></element>
      <element name="sidebar_footer_brand_text" type="text" xpos="center" ypos="center" sizefont="15" color="colortextsoft">Sistema</element>
    </element>
    <element name="sidebar_footer_version" type="text" xpos="54" ypos="845" sizefont="14" color="colortextsoft">v#[APP_VERSION]</element>

    <!-- ======================================================= CARD: Temperatura CPU ======================================================= -->

    <element name="temperature_cpu" type="button" xpos="268" ypos="148" allocationtext="right" sizefont="20">
      <element name="temperature_cpu_icon" type="animation"><image>icons/thermometer_30.png</image></element>
      <element name="temperature_cpu_text" type="text" xpos="center" ypos="center" sizefont="20" color="colortextmain">Temperatura CPU</element>
    </element>
    <element name="cpu_temp_bar" type="progressimage" xpos="300" ypos="395" width="64" height="220" allocationtext="right" direction="vertical" offsetstart="46" offsetend="20" level="0" imageempty="thermo_empty.png" imagefull="thermo_full.png">
      <element name="cpu_temp_value" type="text" xpos="34" ypos="center" sizefont="42" color="220,70,70,255">#[CPU_TEMPERATURE]</element>
    </element>
    <element name="cpu_temp_caption_group" type="button" xpos="430" ypos="272" allocationtext="right" sizefont="15">
      <element name="cpu_temp_caption_group_icon" type="animation"><image>icons/thermometer_30.png</image></element>
      <element name="cpu_temp_caption_group_text" type="text" xpos="center" ypos="center" sizefont="15" color="colortextsoft">Temperatura actual</element>
    </element>

    <!-- ======================================================= CARD: Uso actual de CPU ===================================================== -->

    <element name="cpu_usage_header" type="button" xpos="648" ypos="148" allocationtext="right" sizefont="20">
      <element name="cpu_usage_header_icon" type="animation"><image>icons/cpu_30.png</image></element>
      <element name="cpu_usage_header_text" type="text" xpos="center" ypos="center" sizefont="20" color="colortextmain">Uso actual de CPU</element>
    </element>
    <element name="cpu_usage_radial" type="progressradial" xpos="705" ypos="365" width="190" height="190" level="0" thickness="20" roundcap="yes" startangle="-90" sweepangle="360" bckgrdcolor="colorsidebarbkg" color="90,160,240,255" gradientcolor="50,110,220,255" gradientmode="track">
      <element name="cpu_usage_value" type="text" xpos="center" ypos="center" sizefont="40" color="255,255,255,255">#[PROGRESSBAR_PERCENT]</element>
    </element>
    <element name="cpu_usage_caption" type="text" xpos="752" ypos="404" sizefont="15" color="colortextsoft">Uso actual</element>

    <!-- ===================================================== CARD: Consumo de memoria RAM ================================================== -->

    <element name="ram_usage_header" type="button" xpos="1028" ypos="148" allocationtext="right" sizefont="18">
      <element name="ram_usage_header_icon" type="animation"><image>icons/ram_30.png</image></element>
      <element name="ram_usage_header_text" type="text" xpos="center" ypos="center" sizefont="18" color="colortextmain">Consumo de memoria RAM</element>
    </element>
    <element name="ram_usage_radial" type="progressradial" xpos="1022" ypos="295" width="130" height="130" level="0" thickness="16" roundcap="yes" startangle="-90" sweepangle="360" bckgrdcolor="colorsidebarbkg" color="170,110,240,255" gradientcolor="130,60,220,255" gradientmode="track">
      <element name="ram_usage_value" type="text" xpos="center" ypos="center" sizefont="26" color="255,255,255,255">#[PROGRESSBAR_PERCENT]</element>
    </element>
    <element name="ram_used_total" type="text" xpos="1172" ypos="225" sizefont="24" color="colortextmain" bckgrdcolor="colorpanel">#[RAM_USED_TOTAL]</element>
    <element name="ram_caption" type="text" xpos="1172" ypos="246" sizefont="14" color="colortextsoft">En uso / Total</element>
    <element name="ram_linear_bar" type="progressbar" xpos="1025" ypos="344" allocationtext="none" direction="horizontal" roundcap="yes" progressrect="0,0,310,14" level="0" linecolor="0,0,0,0" bckgrdcolor="colorsidebarbkg" color="170,110,240,255" gradientcolor="130,60,220,255" gradientmode="track"></element>
    <element name="ram_scale_0" type="text" xpos="1025" ypos="366" sizefont="13" color="colortextsoft">0%</element>
    <element name="ram_scale_50" type="text" xpos="1168" ypos="366" sizefont="13" color="colortextsoft">50%</element>
    <element name="ram_scale_100" type="text" xpos="1300" ypos="366" sizefont="13" color="colortextsoft">100%</element>

    <!-- ==================================================== CARD: Fecha y hora del sistema ================================================= -->

    <element name="datetime_header" type="button" xpos="268" ypos="518" allocationtext="right" sizefont="20">
      <element name="datetime_header_icon" type="animation"><image>icons/calendar_30.png</image></element>
      <element name="datetime_header_text" type="text" xpos="center" ypos="center" sizefont="20" color="colortextmain">Fecha y hora del sistema</element>
    </element>
    <element name="system_date" type="text" xpos="270" ypos="585" sizefont="32" color="colortextmain" bckgrdcolor="colorpanel">#[SYSTEM_DATE]</element>
    <element name="system_time" type="text" xpos="270" ypos="645" sizefont="40" color="coloraccent" bckgrdcolor="colorpanel">#[SYSTEM_TIME]</element>
    <element name="datetime_caption_group" type="button" xpos="270" ypos="677" allocationtext="right" sizefont="15">
      <element name="datetime_caption_group_icon" type="animation"><image>icons/clock_22.png</image></element>
      <element name="datetime_caption_group_text" type="text" xpos="center" ypos="center" sizefont="15" color="colortextsoft">Hora local del sistema</element>
    </element>

    <!-- ============================================ CARD: Tiempo de funcionamiento del sistema ============================================= -->

    <element name="uptime_header" type="button" xpos="648" ypos="518" allocationtext="right" sizefont="17">
      <element name="uptime_header_icon" type="animation"><image>icons/clock_30.png</image></element>
      <element name="uptime_header_text" type="text" xpos="center" ypos="center" sizefont="17" color="colortextmain">Tiempo de func. del sistema</element>
    </element>
    <element name="uptime_months_label" type="text" xpos="647" ypos="546" sizefont="13" color="colortextsoft">Meses</element>
    <element name="uptime_months_value" type="text" xpos="656" ypos="628" sizefont="28" color="colorgreen" bckgrdcolor="colorbox">#[UPTIME_MONTHS]</element>
    <element name="uptime_hours_label" type="text" xpos="734" ypos="546" sizefont="13" color="colortextsoft">Horas</element>
    <element name="uptime_hours_value" type="text" xpos="724" ypos="625" sizefont="24" color="colorgreen" bckgrdcolor="colorbox">#[UPTIME_HOURS]</element>
    <element name="uptime_years_label" type="text" xpos="822" ypos="546" sizefont="13" color="colortextsoft">Años</element>
    <element name="uptime_years_value" type="text" xpos="824" ypos="628" sizefont="28" color="colorgreen" bckgrdcolor="colorbox">#[UPTIME_YEARS]</element>
    <element name="uptime_seconds_label" type="text" xpos="895" ypos="546" sizefont="13" color="colortextsoft">Segundos</element>
    <element name="uptime_seconds_value" type="text" xpos="892" ypos="620" sizefont="15" color="colorgreen" bckgrdcolor="colorbox">#[UPTIME_SECONDS]</element>

    <!-- ========================================== CARD: Estado de la conexion a internet ==================================================== -->

    <element name="connection_header" type="button" xpos="1028" ypos="518" allocationtext="right" sizefont="16">
      <element name="connection_header_icon" type="animation"><image>icons/wifi_30.png</image></element>
      <element name="connection_header_text" type="text" xpos="center" ypos="center" sizefont="16" color="colortextmain">Estado de la conexión a internet</element>
    </element>
    <element name="connection_status_mark" type="text" xpos="1044" ypos="572" sizefont="24" color="15,20,26,255">#[CONNECTION_MARK]</element>
    <element name="connection_status_text" type="text" xpos="1110" ypos="570" sizefont="27" color="colortextmain" bckgrdcolor="colorpanel">#[CONNECTION_STATUS]</element>
    <element name="connection_quality" type="text" xpos="1110" ypos="595" sizefont="15" color="colortextsoft" bckgrdcolor="colorpanel">#[CONNECTION_QUALITY]</element>
    <element name="connection_ip" type="text" xpos="1030" ypos="633" sizefont="17" color="colortextsoft" bckgrdcolor="colorpanel">#[LOCAL_IP]</element>
    <element name="connection_net_icon" type="image" xpos="1288" ypos="656" width="56" height="56">icons/wifi.png</element>

    <!-- ================================================================= FOOTER ================================================================= -->

    <element name="footer_equipo_group" type="button" xpos="20" ypos="889" allocationtext="right" sizefont="15">
      <element name="footer_equipo_group_icon" type="animation"><image>icons/monitor_20.png</image></element>
      <element name="footer_equipo_group_text" type="text" xpos="center" ypos="center" sizefont="15" color="colortextsoft" bckgrdcolor="colorsidebar">#[FOOTER_EQUIPO]</element>
    </element>
    <element name="footer_so_group" type="button" xpos="300" ypos="889" allocationtext="right" sizefont="15">
      <element name="footer_so_group_icon" type="animation"><image>icons/gear_20.png</image></element>
      <element name="footer_so_group_text" type="text" xpos="center" ypos="center" sizefont="15" color="colortextsoft" bckgrdcolor="colorsidebar">#[FOOTER_SO]</element>
    </element>
    <element name="footer_uptime_group" type="button" xpos="950" ypos="889" allocationtext="right" sizefont="15">
      <element name="footer_uptime_group_icon" type="animation"><image>icons/clock_20.png</image></element>
      <element name="footer_uptime_group_text" type="text" xpos="center" ypos="center" sizefont="15" color="colortextsoft" bckgrdcolor="colorsidebar">#[FOOTER_UPTIME]</element>
    </element>

  </layout>

</layouts>
