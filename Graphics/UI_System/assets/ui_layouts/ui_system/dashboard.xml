    <element name="nav-cpu-hl"           type="form" class="nav-band" xpos="0" ypos="174" width="210" height="48" visible="no"></element>
    <element name="nav-memoria-hl"       type="form" class="nav-band" xpos="0" ypos="230" width="210" height="48" visible="no"></element>
    <element name="nav-red-hl"           type="form" class="nav-band" xpos="0" ypos="286" width="210" height="48" visible="no"></element>
    <element name="nav-disco-hl"         type="form" class="nav-band" xpos="0" ypos="342" width="210" height="48" visible="no"></element>
    <element name="nav-procesos-hl"      type="form" class="nav-band" xpos="0" ypos="398" width="210" height="48" visible="no"></element>
    <element name="nav-alertas-hl"       type="form" class="nav-band" xpos="0" ypos="454" width="210" height="48" visible="no"></element>
    <element name="nav-configuracion-hl" type="form" class="nav-band" xpos="0" ypos="510" width="210" height="48" visible="no"></element>

    <element name="nav-resumen-bar"       type="form" class="nav-accent" xpos="0" ypos="118" width="4" height="48" visible="yes"></element>
    <element name="nav-cpu-bar"           type="form" class="nav-accent" xpos="0" ypos="174" width="4" height="48" visible="no"></element>
    <element name="nav-memoria-bar"       type="form" class="nav-accent" xpos="0" ypos="230" width="4" height="48" visible="no"></element>
    <element name="nav-red-bar"           type="form" class="nav-accent" xpos="0" ypos="286" width="4" height="48" visible="no"></element>
    <element name="nav-disco-bar"         type="form" class="nav-accent" xpos="0" ypos="342" width="4" height="48" visible="no"></element>
    <element name="nav-procesos-bar"      type="form" class="nav-accent" xpos="0" ypos="398" width="4" height="48" visible="no"></element>
    <element name="nav-alertas-bar"       type="form" class="nav-accent" xpos="0" ypos="454" width="4" height="48" visible="no"></element>
    <element name="nav-configuracion-bar" type="form" class="nav-accent" xpos="0" ypos="510" width="4" height="48" visible="no"></element>

    <!-- Cards -->
