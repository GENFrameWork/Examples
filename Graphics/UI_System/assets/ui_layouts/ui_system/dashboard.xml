    <element name="dt_hdr_text" type="text"  class="card-title" xpos="320" ypos="526" sizefont="19">Fecha y hora del sistema</element>

    <element name="system_date" type="text" class="value-date" xpos="292" ypos="652" sizefont="30">#[SYSTEM_DATE]</element>
    <element name="system_time" type="text" class="value-time" xpos="306" ypos="714" sizefont="34">#[SYSTEM_TIME]</element>

    <element name="dt_cap_icon" type="image" xpos="284" ypos="789" width="36" height="36">icons/cap_clock.svg</element>
    <element name="dt_cap_text" type="text"  class="label-dim" xpos="326" ypos="778" sizefont="13">Hora local del sistema</element>


