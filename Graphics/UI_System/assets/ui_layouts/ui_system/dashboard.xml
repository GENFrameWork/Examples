    </element>

    <element name="ram_scale_0"   type="text" class="label-dim" xpos="1236" ypos="374" sizefont="12">0%</element>
    <element name="ram_scale_50"  type="text" class="label-dim" xpos="1298" ypos="374" sizefont="12">50%</element>
    <element name="ram_scale_100" type="text" class="label-dim" xpos="1358" ypos="374" sizefont="12">100%</element>


