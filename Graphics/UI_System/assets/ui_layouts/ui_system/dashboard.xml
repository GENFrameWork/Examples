    <element name="temp_hdr_text" type="text"  class="card-title" xpos="320" ypos="114" sizefont="19">Temperatura CPU</element>

    <element name="cpu_temp_bar" type="progressimage" xpos="286" ypos="416" width="72" height="220"
             direction="vertical" allocationtext="none"
