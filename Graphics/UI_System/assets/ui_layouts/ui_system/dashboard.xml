    <element name="ram_hdr_text" type="text"  class="card-title" xpos="1116" ypos="114" sizefont="17">Consumo de memoria RAM</element>

    <!-- Grown more modestly than cpu_usage_radial (164->178, +8.5%, vs. the CPU ring's +30%): unlike that card,
         this ring shares its row with the used/total text and the bar, and the worst-case value string, "31.8
         GB / 31.8 GB" (measured against Nunito-SemiBold at sizefont=19: 157 units wide), leaves no room for a
         bigger ring without either overflowing the card's right edge (1410) or shrinking that text. Left edge
         (xpos) kept at the same 22-unit margin from the card's own left edge (1056-1034=22); growing to the
         right pushed every element beside it (ram_used_total, ram_caption, ram_linear_bar, ram_scale_*) right
         by the ring's growth plus extra breathing room, since ram_used_total previously started only 6 units
         past the ring's own right edge (1214 vs 1220), tight enough that the clipped-looking leading digit
         Abraham saw in his last screenshot is likely exactly that margin, independently of the ring resize. -->
    <element name="ram_usage_radial" type="progressradial" class="ring-ram"
             xpos="1056" ypos="366" width="178" height="178"
             level="0" thickness="22" roundcap="yes" startangle="-90" sweepangle="360"
             gradientcolor="163,113,247" gradientmode="track">
      <!-- Same fixed-width reservation as cpu_usage_value; see the comment there. -->
      <element name="ram_usage_value" type="text" class="ring-value" xpos="center" ypos="center" sizefont="39" maxsizetext="4">#[PROGRESSBAR_PERCENT]</element>
    </element>

    <element name="ram_used_total" type="text" class="value-ram" xpos="1250" ypos="250" sizefont="19">#[RAM_USED_TOTAL]</element>
    <element name="ram_caption"    type="text" class="label"     xpos="1290" ypos="278" sizefont="14">En uso / Total</element>

    <!-- progressrect width trimmed from 158 to 140: the bar's left edge moved right along with the rest of this
         column (1220->1256), and the card's right edge (1410) no longer leaves room for the old width without
         overflowing, so it was narrowed to keep a clear margin (1256+140=1396, 14 units clear of 1410). -->
    <element name="ram_linear_bar" type="progressbar" class="bar-ram"
             xpos="1256" ypos="348" allocationtext="none" direction="horizontal"
             roundcap="yes" progressrect="0,0,140,14" level="0" linecolor="0,0,0,0"
             gradientcolor="163,113,247" gradientmode="track">
    </element>

    <element name="ram_scale_0"   type="text" class="label-dim" xpos="1256" ypos="374" sizefont="12">0%</element>
    <element name="ram_scale_50"  type="text" class="label-dim" xpos="1313" ypos="374" sizefont="12">50%</element>
    <element name="ram_scale_100" type="text" class="label-dim" xpos="1363" ypos="374" sizefont="12">100%</element>


