    <element name="nav-cpu-btn"           type="button" class="nav-hit" xpos="0" ypos="174" width="210" height="48" roundrect="0"></element>
    <element name="nav-memoria-btn"       type="button" class="nav-hit" xpos="0" ypos="230" width="210" height="48" roundrect="0"></element>
    <element name="nav-red-btn"           type="button" class="nav-hit" xpos="0" ypos="286" width="210" height="48" roundrect="0"></element>
    <element name="nav-disco-btn"         type="button" class="nav-hit" xpos="0" ypos="342" width="210" height="48" roundrect="0"></element>
    <element name="nav-procesos-btn"      type="button" class="nav-hit" xpos="0" ypos="398" width="210" height="48" roundrect="0"></element>
