    <element name="cpu_temp_value" type="text" class="value-temp" xpos="404" ypos="276" sizefont="50">#[CPU_TEMPERATURE]</element>

    <element name="temp_cap_icon" type="image" xpos="447" ypos="377" width="60" height="60">icons/cap_thermo.svg</element>
