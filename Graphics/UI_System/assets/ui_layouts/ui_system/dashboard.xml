    <element name="brand_icon"    type="image" xpos="26" ypos="831" width="52" height="52">icons/brand_system.svg</element>
    <element name="brand_text"    type="text"  class="brand"     xpos="88" ypos="808" sizefont="15">Sistema</element>
    <element name="brand_version" type="text"  class="brand-dim" xpos="88" ypos="830" sizefont="13">v#[APP_VERSION]</element>


    <!-- ==========================================================================================
         CARD 1 : Temperatura CPU
         ========================================================================================== -->

