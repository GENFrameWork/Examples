    <element name="nav-configuracion-icon" type="image" xpos="26" ypos="508" width="44" height="44">icons/nav_config.svg</element>

    <element name="nav-resumen-text"       type="text" class="nav-label" xpos="84" ypos="103" sizefont="16">Resumen</element>
    <element name="nav-cpu-text"           type="text" class="nav-label" xpos="84" ypos="159" sizefont="16">CPU</element>
    <element name="nav-memoria-text"       type="text" class="nav-label" xpos="84" ypos="215" sizefont="16">Memoria</element>
    <element name="nav-red-text"           type="text" class="nav-label" xpos="84" ypos="271" sizefont="16">Red</element>
    <element name="nav-disco-text"         type="text" class="nav-label" xpos="84" ypos="327" sizefont="16">Disco</element>
    <element name="nav-procesos-text"      type="text" class="nav-label" xpos="84" ypos="383" sizefont="16">Procesos</element>
    <element name="nav-alertas-text"       type="text" class="nav-label" xpos="84" ypos="439" sizefont="16">Alertas</element>
    <element name="nav-configuracion-text" type="text" class="nav-label" xpos="84" ypos="495" sizefont="16">Configuracion</element>

    <!-- Hit targets. They carry an explicit width/height and no sub-elements, so
