    <element name="card_cpu_usage"  type="form" class="card" xpos="636"  ypos="460" width="376" height="390"></element>
    <element name="card_ram"        type="form" class="card" xpos="1034" ypos="460" width="376" height="390"></element>
    <element name="card_datetime"   type="form" class="card" xpos="238"  ypos="828" width="376" height="346"></element>
    <element name="card_uptime"     type="form" class="card" xpos="636"  ypos="828" width="376" height="346"></element>
    <element name="card_connection" type="form" class="card" xpos="1034" ypos="828" width="376" height="346"></element>

    <!-- Inset panels -->
    <element name="datetime_box"       type="form" class="inner-box" xpos="266" ypos="736" width="320" height="140"></element>
    <element name="uptime_box_months"  type="form" class="tile"      xpos="656" ypos="762" width="80"  height="136"></element>
    <element name="uptime_box_hours"   type="form" class="tile"      xpos="742" ypos="762" width="80"  height="136"></element>
    <element name="uptime_box_years"   type="form" class="tile"      xpos="828" ypos="762" width="80"  height="136"></element>
